--- a/docker/swarm/base/node/scripts/clang-wrapper.sh
+++ b/docker/swarm/base/node/scripts/clang-wrapper.sh
@@ -3,14 +3,14 @@
 
 case "$0" in
   *++)
-    compiler=/usr/bin/clang++-23
+    compiler=/usr/bin/clang++-"${LLVM_VERSION:-23}"
     # Debian's GCC 14 libstdc++ headers mark the shared_ptr atomic free functions
     # used by V8's wasm headers deprecated. Clang emits thousands of identical
     # diagnostics, overflowing BuildKit's log and hiding the actual build error.
     diagnostic_flag=-Wno-deprecated-declarations
     ;;
   *)
-    compiler=/usr/bin/clang-23
+    compiler=/usr/bin/clang-"${LLVM_VERSION:-23}"
     # libffi deliberately does null-pointer arithmetic while deriving field
     # alignment; Clang diagnoses that GNU extension once per generated target.
     diagnostic_flag=-Wno-gnu-null-pointer-arithmetic
