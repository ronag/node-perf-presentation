 # Use the latest Clang/LLVM 23 packages from apt.llvm.org. Verify its
 # signing-key fingerprint before adding the repository.
-RUN curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
+# A/B: LLVM_VERSION=20 matches the compiler of the official Node 26 binaries.
+ARG LLVM_VERSION=23
+ENV LLVM_VERSION=${LLVM_VERSION}
+# apt.llvm.org's trixie LLVM 20 packages ship no LLVMgold.so (bfd + LTO fails);
+# the bookworm build of the same 20.1.8 release has it and runs on trixie.
+RUN dist=trixie; if [ "${LLVM_VERSION}" = 20 ]; then dist=bookworm; fi; \
+  curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
     -o /tmp/llvm-snapshot.gpg.key \
   && test "$(gpg --show-keys --with-colons /tmp/llvm-snapshot.gpg.key \
     | awk -F: '$1 == "pub" { primary = 1; next } primary && $1 == "fpr" { print $10; primary = 0 }')" \
@@ -50,25 +56,26 @@
     -o /usr/share/keyrings/apt.llvm.org.gpg \
     /tmp/llvm-snapshot.gpg.key \
   && printf '%s\n' \
-    'deb [signed-by=/usr/share/keyrings/apt.llvm.org.gpg] https://apt.llvm.org/trixie/ llvm-toolchain-trixie-23 main' \
+    "deb [signed-by=/usr/share/keyrings/apt.llvm.org.gpg] https://apt.llvm.org/${dist}/ llvm-toolchain-${dist}-${LLVM_VERSION} main" \
     > /etc/apt/sources.list.d/llvm.list \
   && apt-get update \
   && apt-get install -y --no-install-recommends \
-    clang-23 \
-    libclang-rt-23-dev \
-    llvm-23 \
+    clang-${LLVM_VERSION} \
+    libclang-rt-${LLVM_VERSION}-dev \
+    llvm-${LLVM_VERSION} \
   && rm -rf /var/lib/apt/lists/*
 
 COPY scripts/clang-wrapper.sh /usr/local/bin/node-clang
 RUN chmod 0755 /usr/local/bin/node-clang \
   && ln -s node-clang /usr/local/bin/node-clang++ \
-  && test "$(clang-23 -dumpversion | cut -d. -f1)" = 23
+  && test "$(clang-${LLVM_VERSION} -dumpversion | cut -d. -f1)" = "${LLVM_VERSION}"
 
-ENV AR=/usr/bin/llvm-ar-23
+ENV AR=/usr/bin/llvm-ar-${LLVM_VERSION}
