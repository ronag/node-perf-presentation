{
  "name": "nodeconf-eu-2026-node-performance",
  "version": "2.0.0",
  "private": true,
  "description": "Node.js Performance Tips & Tricks: NodeConf EU 2026 talk by Robert Nagy (slides + benchmarks)",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "bench": "node scripts/bench-all.mjs",
    "bench:async": "node --expose-gc benchmarks/async-overhead.mjs",
    "bench:async-return": "node --expose-gc benchmarks/async-return.mjs",
    "bench:atomics": "node --expose-gc benchmarks/atomics.mjs",
    "bench:bitmap": "node --expose-gc benchmarks/bitmap.mjs",
    "bench:cache": "node --expose-gc benchmarks/cache.mjs",
    "bench:closures": "node --expose-gc benchmarks/closures.mjs",
    "bench:containers-cold": "for t in intrusive-array intrusive-list array set wrapper-list; do TYPE=$t LISTS=100000 node --max-old-space-size=4096 benchmarks/containers-cold.mjs; done",
    "bench:cluster": "node benchmarks/cluster-vs-workers.mjs",
    "bench:cross-thread": "node --expose-gc benchmarks/cross-thread.mjs",
    "bench:fast-time": "node --expose-gc benchmarks/fast-time.mjs",
    "bench:fs": "node --expose-gc benchmarks/fs-sync-vs-async.mjs",
    "bench:gc": "node --expose-gc benchmarks/gc-pressure.mjs",
    "bench:intrusive": "node --expose-gc benchmarks/intrusive-containers.mjs",
    "bench:map-same-key": "node --expose-gc benchmarks/map-same-key.mjs",
    "bench:poolsize": "node --expose-gc benchmarks/poolsize.mjs && BUFFER_POOL_SIZE=1048576 node --expose-gc benchmarks/poolsize.mjs",
    "bench:queue": "node --expose-gc benchmarks/function-queue.mjs",
    "bench:semi-space": "node --expose-gc benchmarks/semi-space.mjs && node --expose-gc --max-semi-space-size=64 benchmarks/semi-space.mjs",
    "bench:slice": "node --expose-gc benchmarks/slice.mjs",
    "bench:res-write": "node benchmarks/res-write.mjs",
    "bench:sqlite": "node --expose-gc benchmarks/sqlite-pragmas.mjs && node benchmarks/sqlite-contention.mjs && node benchmarks/sqlite-maintenance.mjs && node benchmarks/sqlite-cache-shards.mjs",
    "bench:streams": "node --expose-gc benchmarks/streams.mjs",
    "bench:subarray": "node --expose-gc benchmarks/subarray-vs-slice.mjs",
    "bench:threadpool": "UV_THREADPOOL_SIZE=4 node benchmarks/uv-threadpool.mjs && UV_THREADPOOL_SIZE=16 node benchmarks/uv-threadpool.mjs",
    "bench:timers": "node --expose-gc benchmarks/timers.mjs",
    "bench:url": "node --expose-gc benchmarks/url.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronag/node-perf-presentation.git"
  },
  "author": "Robert Nagy",
  "license": "ISC",
  "homepage": "https://github.com/ronag/node-perf-presentation#readme",
  "engines": {
    "node": ">=26.1"
  },
  "dependencies": {
    "lru-cache": "^11.2.6",
    "mitata": "^1.0.34",
    "reveal.js": "^5.2.1"
  },
  "optionalDependencies": {
    "@nxtedition/cache": "^3.3.12",
    "@nxtedition/shared": "^6.0.8",
    "@nxtedition/slice": "^2.1.1",
    "@nxtedition/timers": "^1.1.16",
    "request-target": "^1.0.2"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  }
}
